#: src/link_shortener/domain/policies/guest_quota_policy.py:58
#, python-format
msgid "Guest link limit of %(limit)s exceeded."
msgstr "Превышен гостевой предел в %(limit)s ссылок."

#: src/link_shortener/domain/policies/password_policy.py:90
msgid "Password must not be blank"
msgstr "Пароль не может состоять из одних невидимых символов"

#: src/link_shortener/domain/policies/password_policy.py:101
msgid "Password must not contain a null character"
msgstr "Пароль не может содержать нулевой символ"

#: src/link_shortener/domain/policies/password_policy.py:109
#, python-format
msgid "Password must be at least %(count)s characters"
msgstr "Пароль должен быть не короче %(count)s символов"

#: src/link_shortener/domain/policies/password_policy.py:131
#, python-format
msgid ""
"Password must not exceed %(count)s characters, and fewer for alphabets "
"that need more room per character"
msgstr ""
"Пароль не должен превышать %(count)s символов — и меньше для "
"письменностей, которым нужно больше места на символ"

#: src/link_shortener/domain/policies/password_policy.py:142
msgid "Password is too common -- choose one that is not on every attacker's list"
msgstr ""
"Пароль слишком распространён — выберите тот, которого нет в списке у "
"каждого злоумышленника"

#: src/link_shortener/domain/policies/privilege_policy.py:105
#, python-format
msgid "You cannot grant permissions you do not hold yourself: %(permissions)s"
msgstr "Нельзя выдать права, которых нет у вас самих: %(permissions)s"

#: src/link_shortener/domain/policies/privilege_policy.py:125
msgid "This would leave the system without an administrator"
msgstr "После этого система осталась бы без администратора"

#: src/link_shortener/domain/policies/role_policy.py:130
msgid "A role name must be letters, digits, hyphen or underscore"
msgstr "Имя роли может состоять из букв, цифр, дефиса и подчёркивания"

#: src/link_shortener/domain/policies/role_policy.py:140
#, python-format
msgid "A role name must be %(least)s to %(most)s characters long"
msgstr "Имя роли должно быть длиной от %(least)s до %(most)s символов"

#: src/link_shortener/domain/policies/role_policy.py:198
msgid "A role description must be text"
msgstr "Описание роли должно быть текстом"

#: src/link_shortener/domain/policies/role_policy.py:207
#, python-format
msgid "A role description must be at most %(most)s characters long"
msgstr "Описание роли не должно быть длиннее %(most)s символов"

#: src/link_shortener/domain/value_objects/email.py:104
msgid "Invalid email format"
msgstr "Неверный формат адреса"

#: src/link_shortener/domain/value_objects/original_url.py:172
