# Конфигурация flake8.
#
# Отдельным файлом: pyproject.toml flake8 не читает, и секция [tool.flake8]
# там не действует.
#
# select оставляет два семейства дефектов:
#   F   pyflakes — неиспользованный импорт, неиспользованная переменная,
#       неизвестное имя, повторное определение
#   E9  синтаксис и ошибки чтения файла
#
# И четыре кода хвостового мусора — пробелы, которых никто не писал нарочно:
#   W291  пробел в конце строки
#   W292  файл без завершающего перевода строки
#   W293  пустая строка с пробелами
#   W391  пустая строка в конце файла
#
# Они здесь не ради строгости, а потому что autopep8 читает этот же select:
# один и тот же список делает flake8 сторожем, а форматтер — исполнителем.
# Пока их не было, autopep8 наследовал select = E9,F и молчал: хвостовой
# мусор накопился в 65 файлах и ни один прогон его не назвал.
#
# Раскладка (E1, E2, E3, E5, W5) остаётся вне select и принадлежит владельцу
# проекта: под ней autopep8 переписал бы дерево, а не поправил его.
#
# max-line-length и extend-ignore под этим select не действуют: ни E501, ни
# E203, ни W503 в выбранные семейства не входят. Оставлены как ориентир для
# ручного запуска с более широким select.

[flake8]
select = E9,F,W291,W292,W293,W391
max-line-length = 88
extend-ignore = E203,W503
exclude =
    .git,
    .venv,
    __pycache__,
    htmlcov,
    migrations/versions
