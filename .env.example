# ==============================================================================
# Link Shortener — шаблон конфигурации
# ==============================================================================
#
#   cp .env.example .env
#   flask security generate-secrets     # выдаст SECRET_KEY и SHORT_CODE_PEPPER
#
# ------------------------------------------------------------------------------
# Как читать этот файл
# ------------------------------------------------------------------------------
# У каждой переменной одна строка описания в формате:
#
#   # что делает · допустимые значения · где применима
#
# «Где применима» — это профиль, выбираемый через FLASK_ENV:
#
#   dev      development — локальная разработка
#   stag     staging     — предпродакшн
#   prod     production  — боевой запуск
#   compose  переменную читает docker compose, а не приложение
#
# Профиль testing в списках не появляется: он НЕ читает ни .env, ни настоящие
# переменные окружения — автотесты обязаны давать одинаковый результат на любой
# машине и берут значения только из TestingConfig.
#
# Приоритет источников, побеждает верхний:
#
#   1. настоящая переменная окружения (export VAR=..., environment: в compose)
#   2. .env.<профиль>              например .env.production
#   3. .env                        этот файл
#   4. умолчание профиля           код в infrastructure/configs/app/
#
# ------------------------------------------------------------------------------
# Минимум, без которого НЕ ЗАПУСТИТСЯ staging и production
# ------------------------------------------------------------------------------
# С пустым окружением эти профили отказываются стартовать и называют пять
# причин. development и testing поднимаются без единой заданной переменной.
#
#   SECRET_KEY           подписывает JWT и сессии; умолчание генерируется
#                        случайно на каждый процесс, поэтому у воркеров оно
#                        разное и токены одного не принимает другой
#   SHORT_CODE_PEPPER    соль генерации кодов; разойдётся между инстансами —
#                        разойдутся и коды для одного URL
#   DOMAIN               адрес, из которого строится каждая короткая ссылка;
#                        без него берётся HOST:PORT, то есть адрес, по которому
#                        процесс слушает, а не тот, по которому к нему приходят
#   DATABASE_TYPE=postgresql
#                        плюс DATABASE_HOST, DATABASE_NAME, DATABASE_USER —
#                        либо всё это одной строкой в DATABASE_URL. На SQLite
#                        эти профили не стартуют: умолчания завели бы пустой
#                        новый файл, и сервис отвечал бы так, будто данных
#                        никогда не было. DATABASE_PASSWORD не обязателен —
#                        peer, trust и .pgpass работают без него
#   REDIS_URL            на этих профилях REDIS_ENABLED=true по умолчанию, а
#                        включённый Redis без адреса — это кэш и ограничитель
#                        частоты, которые не к чему подключить
#
# Условно обязательные: MAIL_HOST и MAIL_FROM — если MAIL_ENABLED=true.
# ==============================================================================


# ==============================================================================
# 1. Профиль и запуск
# ==============================================================================

# Какой профиль конфигурации выбрать · development | staging | production |
# testing · везде. Не задан — берётся development
FLASK_ENV=development

# Точка входа для команды flask · путь вида модуль:фабрика · везде
FLASK_APP=link_shortener.web.app_factory:create_app

# Отладчик и автоперезагрузка встроенного сервера flask run · 1 | 0 · dev.
# На сам профиль не влияет: DEBUG задан профилем и переменной не меняется
FLASK_DEBUG=1


# ==============================================================================
# 2. Секреты                                              ОБЯЗАТЕЛЬНО stag/prod
# ==============================================================================
# Оба генерируются командой `flask security generate-secrets`.
# Никогда не коммитьте заполненные значения.

# Подписывает JWT, сессии и записи кэша · hex-строка 64 байта · везде.
# ОБЯЗАТЕЛЬНО на stag/prod: умолчание случайно на каждый процесс, поэтому
# токены умирают при рестарте и не переносятся между воркерами
SECRET_KEY=

# Соль хеширования URL при генерации кода · любая длинная строка · везде.
# ОБЯЗАТЕЛЬНО на stag/prod: разные значения на инстансах дадут разные коды
# для одного и того же адреса
SHORT_CODE_PEPPER=


# ==============================================================================
# 3. Адрес сервиса
# ==============================================================================

# Интерфейс, на котором слушает сервер · IP или имя хоста · везде.
# 127.0.0.1 — только с этой машины, 0.0.0.0 — со всех интерфейсов.
# Без DOMAIN отсюда же собирается адрес в короткой ссылке, поэтому 0.0.0.0
# даёт ссылки вида http://0.0.0.0:5000/<код>.
# Умолчание профиля — localhost; в контейнере привязку задаёт ${HOST:-0.0.0.0}
# из CMD образа
# HOST=0.0.0.0

# Порт, на котором слушает сервер · 1..65535 · везде.
# Умолчание: 5000, в prod — 8000
PORT=5000

# Куда привязывается локальный `flask run` · подставляется из HOST и PORT ·
# dev. Flask CLI знает только эти два имени, поэтому менять нужно HOST и
# PORT, а не эту пару.
# Обе строки обязаны стоять ПОСЛЕ тех, на которые ссылаются: подстановка в
# env-файле разрешается по ходу чтения. Умолчание у ${HOST} нужно потому,
# что сам HOST закомментирован.
FLASK_RUN_HOST=${HOST:-localhost}
FLASK_RUN_PORT=${PORT}

# Публичное имя хоста, из которого строится каждая короткая ссылка ·
# имя хоста без схемы и пути, можно с портом (short.example.com:8443) ·
# везде. ОБЯЗАТЕЛЬНО на stag/prod. Значение со схемой (https://short...)
# дало бы https://https://short... и отвергается при старте; форму имени
# дальше проверяет DNS, а не приложение
# DOMAIN=

# Собирать публичные ссылки как https · true | false · везде.
# Профиль сам знает: false на dev, true на stag/prod. Задайте явно, только
# если развёртывание работает без TLS
# USE_HTTPS=false

# Порт, на котором приложение публикуется на хосте · 1..65535 · compose
APP_HOST_PORT=5000


# ==============================================================================
# 4. База данных
# ==============================================================================

# --- Что за база ---

# Тип СУБД · sqlite | postgresql · везде.
# На stag/prod допустим только postgresql — SQLite там означала бы пустой
# новый файл вместо данных
DATABASE_TYPE=sqlite

# Имя базы, а для sqlite — имя файла · строка · везде.
# Относительное имя кладётся в каталог из DATABASE_DIR, а не в рабочий
# каталог процесса: иначе `flask`, запущенный из src/, открывал бы второй,
# пустой файл и молчал бы об этом. Абсолютный путь берётся как есть и
# DATABASE_DIR тогда не читается
DATABASE_NAME=db_shortener.db

# Каталог, в котором лежат файлы sqlite · путь · везде. Postgres не читает.
# Относительный отсчитывается от корня проекта, абсолютный берётся как есть
# и работает в том числе в контейнере, где корня проекта нет (пакет стоит в
# site-packages) — так называют смонтированный том, например /var/lib/app.
# Каталог создаётся сам
DATABASE_DIR=datas/databases

# Готовая строка подключения целиком · URL SQLAlchemy · везде.
# Если задана, все DATABASE_* выше и ниже не читаются вовсе.
# Пример: postgresql+psycopg://user:pass@localhost:5432/db_shortener
# DATABASE_URL=

# --- Подключение (только postgresql) ---

# Адрес сервера БД · имя хоста или IP · везде. В docker-сети это имя сервиса
DATABASE_HOST=localhost

# Порт сервера БД · 1..65535 · везде.
# В docker им же задаётся порт, на котором слушает контейнер PostgreSQL:
# одна величина вместо порта образа и настройки приложения
DATABASE_PORT=5432

# Пользователь БД · строка · везде. ОБЯЗАТЕЛЕН на stag/prod без DATABASE_URL
DATABASE_USER=

# Пароль пользователя · строка · везде. Не обязателен: peer, trust, .pgpass
# и PGPASSWORD работают без него
DATABASE_PASSWORD=

# --- Тайм-ауты и пул (только postgresql) ---

# Предел ожидания подключения, секунды · целое > 0 · везде.
# Без него ждём TCP-таймаут ОС — это минуты, а healthcheck сдаётся за 10 с
DATABASE_CONNECT_TIMEOUT=3

# Предел на один SQL-запрос, секунды · целое > 0 · везде.
# Замороженный, но отвечающий на уровне ядра сервер этим не закрывается
DATABASE_STATEMENT_TIMEOUT=10

# Постоянных соединений в пуле · целое > 0 · везде.
# Ноль SQLAlchemy читает как «без предела» и заодно молча отменяет
# DATABASE_MAX_OVERFLOW — держите значение положительным.
# Величина на процесс: sync-воркер ведёт один запрос и держит одно
# соединение. Подбор значения — DEVELOPER_GUIDE, «Нагрузочный профиль»
DATABASE_POOL_SIZE=5

# Дополнительных соединений сверх пула на пике · целое, -1 = без предела ·
# везде. Потолок умножается на число воркеров, а PostgreSQL по умолчанию
# разрешает сотню соединений
DATABASE_MAX_OVERFLOW=5

# Пересоздавать соединение через N секунд · целое, -1 = никогда · везде.
# Защита от разрыва простаивающих соединений на стороне сети
DATABASE_POOL_RECYCLE=3600

# Проверять соединение запросом перед выдачей из пула · true | false · везде.
# Стоит один лишний round-trip, зато переживает перезапуск базы
DATABASE_POOL_PRE_PING=true

# --- Схема и данные ---

# Печатать в лог каждый SQL-запрос · true | false · dev.
# На stag/prod оставляйте false: в логи попадут значения полей
SQLALCHEMY_ECHO=false

# Управлять схемой через alembic · true | false · везде.
# false открывает `flask db init` и `flask db drop`, которые создают и
# удаляют таблицы напрямую, минуя ревизии
USE_ALEMBIC=true

# Строка подключения для одной команды alembic · URL SQLAlchemy · везде.
# Перекрывает всё остальное и не требует рабочей конфигурации приложения —
# для миграции на базу, к которой сервис ещё не настроен
# ALEMBIC_DATABASE_URL=

# Досоздавать системные роли при каждом старте · true | false · везде.
# Профиль сам знает: true на dev, false на stag/prod, где роли засеивают
# один раз командой `flask db load-base-roles`
# AUTO_SEED_ROLES=true

# --- Публикация на хост (docker) ---

# Порт PostgreSQL на хосте · 1..65535 · compose
DATABASE_HOST_PORT=5432

# Адрес, на котором порт БД публикуется на хосте · IP · compose.
# Петля означает «видно только с этой машины»; 0.0.0.0 отдаёт базу всей
# сети, и защищает её один лишь пароль
DATABASE_BIND_ADDRESS=127.0.0.1


# ==============================================================================
# 5. Кэш и Redis
# ==============================================================================
# Три рабочих сочетания: кэша нет (CACHE_ENABLED=false), кэш в памяти процесса
# (CACHE_ENABLED=true, REDIS_ENABLED=false), кэш в Redis (оба true).

# Использовать кэш вообще · true | false · везде.
# false — все обращения к кэшу становятся холостыми
CACHE_ENABLED=true

# Есть ли у развёртывания Redis · true | false · везде.
# Профиль сам знает: false на dev, true на stag/prod. Управляет не только
# кэшем: ограничитель частоты запросов тоже спрашивает эту переменную
# REDIS_ENABLED=false

# Адрес Redis · redis://[:пароль@]хост:порт/номер-базы · везде.
# ОБЯЗАТЕЛЕН на stag/prod при REDIS_ENABLED=true.
# В docker пусто означает Redis из этого же стека; заданное значение
# перекрывает подстановку compose — так подключают внешний или managed
# REDIS_URL=redis://localhost:6379/0

# Пароль Redis, из которого compose собирает REDIS_URL · строка · compose
REDIS_PASSWORD=

# Порт, на котором Redis слушает внутри docker-сети · 1..65535 · везде.
# Им же собирается REDIS_URL для контейнеров стека, поэтому менять его
# достаточно здесь. Для внешнего Redis порт указывают прямо в REDIS_URL
REDIS_PORT=6379

# Предел ожидания подключения к Redis, секунды · целое > 0 · везде
REDIS_CONNECT_TIMEOUT=2

# Предел ожидания ответа на команду, секунды · целое > 0 · везде
REDIS_SOCKET_TIMEOUT=2

# Пауза перед повторной попыткой после обрыва, секунды · целое > 0 · везде.
# Пока пауза идёт, кэш отвечает промахом, а не ждёт соединения
REDIS_RETRY_INTERVAL=10

# Префикс ключей этого сервиса в Redis · строка · везде.
# Разные префиксы позволяют держать несколько установок на одном сервере
CACHE_LINK_PREFIX=link_shortener

# Сколько живёт запись о ссылке в кэше, секунды · целое >= 0 · везде.
# Умолчание: 3600, на dev — 20, чтобы правки было видно сразу
CACHE_LINK_TTL=3600

# Сколько живёт кэш сводной статистики, секунды · целое >= 0 · везде.
# Умолчание: 300, на dev — 20
CACHE_STATS_TTL=300

# Порт Redis на хосте · 1..65535 · compose
REDIS_HOST_PORT=6379



# ==============================================================================
# 6. Фоновые задачи (Celery)
# ==============================================================================
# Выключенный Celery не теряет работу: подсчёт кликов и отправка писем
# выполняются синхронно, прямо в обработчике запроса.

# Выносить работу в фоновый воркер · true | false · везде
CELERY_ENABLED=false

# Адрес брокера задач · redis://[:пароль@]хост:порт/номер-базы · везде.
# Нужен при CELERY_ENABLED=true. Отдельная база Redis от кэша: чистка кэша
# не должна стирать очередь. В docker пусто означает брокер из этого стека,
# заданное значение — любой внешний
CELERY_BROKER_URL=

# Куда складывать результаты задач · тот же формат · везде.
# Пусто — результаты не хранятся; здешним задачам они не нужны
CELERY_RESULT_BACKEND=

# Предел ожидания брокера, секунды · целое > 0 · везде.
# Без него постановка задачи ждёт брокера бесконечно, держа запрос
CELERY_BROKER_TIMEOUT=2

# Порт брокера Redis на хосте · 1..65535 · compose.
# Не 6380: этот порт занимает Redis тестового стека
REDIS_BROKER_HOST_PORT=6381

# Порт, на котором брокер слушает внутри docker-сети · 1..65535 · compose.
# Отдельно от REDIS_PORT: кэш и очередь — разные серверы, и разводить их
# по портам бывает нужно, когда оба публикуются наружу
REDIS_BROKER_PORT=6379


# ==============================================================================
# 7. Почта и подтверждение адреса
# ==============================================================================
# Без включённой почты регистрация проходит, но подтвердить адрес нечем —
# войти в такую учётную запись нельзя.

# Отправлять письма · true | false · везде.
# При true ОБЯЗАТЕЛЬНЫ MAIL_HOST и MAIL_FROM — иначе старт прерывается.
# Без почты регистрация проходит, а подтвердить адрес нечем
MAIL_ENABLED=true

# Сервер отправки · имя хоста · везде. Умолчание на dev — localhost
# (ловушка Mailpit); на stag/prod умолчания нет.
# В docker пусто означает ловушку из этого же стека
MAIL_HOST=

# Порт отправки · 587 STARTTLS | 465 SSL | 1025 Mailpit · везде.
# Профиль сам знает: 1025 на dev, 587 на stag/prod
# MAIL_PORT=587

# Учётная запись на сервере отправки · строка · везде.
# Пусто — соединение без аутентификации, как у локальной ловушки
MAIL_USERNAME=

# Пароль к ней · строка · везде.
# Задан без MAIL_USERNAME — старт прерывается: аутентифицировать нечем
MAIL_PASSWORD=

# Шифровать соединение через STARTTLS · true | false · везде.
# Взаимоисключающе с MAIL_USE_SSL.
# Профиль сам знает: false на dev, true на stag/prod, где старт без
# шифрования прерывается
# MAIL_USE_TLS=true

# Подключаться сразу по TLS, порт 465 · true | false · везде
MAIL_USE_SSL=false

# Адрес в поле From · почтовый адрес · везде.
# ОБЯЗАТЕЛЕН при MAIL_ENABLED=true. Пусто означает умолчание профиля:
# no-reply@link-shortener.local на dev, на stag/prod умолчания нет
MAIL_FROM=

# Предел ожидания почтового сервера, секунды · число > 0 · везде
MAIL_TIMEOUT=10

# Сколько живёт ссылка подтверждения, часы · целое > 0 · везде
EMAIL_VERIFICATION_TTL_HOURS=24

# Сколько живёт ссылка сброса пароля, минуты · целое > 0 · везде.
# Минуты, а не часы: подтверждение доказывает, что ящик читают, а эта
# ссылка открывает саму учётную запись и всё это время лежит в почте
PASSWORD_RESET_TTL_MINUTES=60

# Через сколько удаляется неподтверждённая учётная запись, часы ·
# целое > 0 · везде. Не может быть меньше EMAIL_VERIFICATION_TTL_HOURS:
# иначе учётку снесёт раньше, чем истечёт высланная на неё ссылка
UNVERIFIED_ACCOUNT_TTL_HOURS=72

# Порты локальной ловушки писем на хосте · 1..65535 · compose.
# SMTP принимает почту, UI показывает её в браузере
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# ==============================================================================
# 8. Логи, аудит и наблюдаемость
# ==============================================================================

# Общий бюджет времени на опрос зависимостей для /health, секунды ·
# число > 0 · везде. Делится между всеми проверками, а не даётся каждой:
# зависшая база не должна держать ответ дольше этого срока
HEALTH_CHECK_TIMEOUT=5

# Вести журнал приложения · true | false · везде.
# false равнозначно LOGGER_TYPE=null
LOGGING_ENABLED=true

# Вести журнал аудита — кто создал, открыл, удалил ссылку · true | false ·
# везде. false равнозначно AUDIT_TYPE=null
AUDIT_ENABLED=true

# Чем писать журнал приложения · auto | structlog | standard | null · везде.
# auto и structlog дают цепочку structlog → standard: если первый перестаёт
# принимать записи, работа переходит ко второму и возвращается обратно,
# когда тот оживёт
LOGGER_TYPE=auto

# Чем писать журнал аудита · auto | structlog | standard | null · везде
AUDIT_TYPE=auto

# Нижний уровень записи · DEBUG | INFO | WARNING | ERROR | CRITICAL · везде.
# Умолчание: DEBUG на dev, INFO на stag/prod
LOG_LEVEL=INFO

# Писать в стандартный вывод · true | false · везде.
# Профиль сам знает: true на dev, false на stag/prod
# LOG_TO_CONSOLE=true

# Писать в файлы · true | false · везде.
# Профиль сам знает: false на dev, true на stag/prod
# LOG_TO_FILE=false

# Каталог файлов журнала · путь · везде.
# Относительный отсчитывается от корня проекта, поэтому у команды,
# запущенной не из корня, каталог тот же
LOG_DIR=datas/logs

# Имена файлов внутри LOG_DIR, без расширения · строка · везде
LOG_FILENAME=application
AUDIT_LOG_FILENAME=audit
ERROR_LOG_FILENAME=error

# Уровни чужих журналов — SQLAlchemy и встроенного сервера ·
# DEBUG | INFO | WARNING | ERROR | CRITICAL · везде.
# Ниже WARNING оба заметно шумят
SQLALCHEMY_LOG_LEVEL=WARNING
WERKZEUG_LOG_LEVEL=WARNING

# Как часто проверять, ожил ли основной журнал, секунды · число > 0 · везде
FAILOVER_CHECK_INTERVAL=30


# ==============================================================================
# 9. Правила работы со ссылками
# ==============================================================================

# Схемы, которые принимаются в сокращение · список через запятую · везде.
# Расширять нечем: всё, кроме http и https, отвергается проверкой
ALLOWED_SCHEMES=http,https

# Предельная длина исходного адреса, символы · целое 1..2048 · везде.
# Выше 2048 не поднимается: столько отведено колонке в базе
MAX_URL_LENGTH=2048

# Разрешить ссылки внутрь собственной сети · true | false · везде.
# Включайте только для установки, недоступной снаружи: иначе сервис
# пересылает запросы из браузера посетителя в вашу сеть
ALLOW_INTERNAL_TARGETS=false

# Сколько раз пробовать другой код при совпадении · целое > 0 · везде
MAX_COLLISION_ATTEMPTS=5

# Сколько адресов принимается за один пакетный запрос · целое 1..100 ·
# везде. Выше 100 не поднимается: длиннее список отвергает схема запроса
BATCH_CREATE_LIMIT=100

# Сколько ссылок может создать гость за окно · целое > 0 · везде
GUEST_LINK_LIMIT=10

# Длина этого окна, сутки · целое > 0 · везде
GUEST_LINK_WINDOW_DAYS=1

# Срок жизни гостевой ссылки, секунды · целое > 0 · везде.
# Умолчание — семь суток. Ноль здесь означал бы «никогда не истекает»
DEFAULT_GUEST_TTL_SECONDS=604800

# Наибольший срок жизни, который можно запросить, секунды · целое > 0 ·
# везде. Умолчание — десять лет
MAX_TTL_SECONDS=315360000

# С какого числа переходов ссылка считается популярной · целое >= 0 · везде
POPULAR_THRESHOLD=100

# За сколько последних суток ссылка считается свежей · целое >= 0 · везде
RECENT_DAYS=7


# ==============================================================================
# 10. Доступ: аутентификация, роли, лимиты, cookie
# ==============================================================================

# --- Токены ---

# Сколько живёт токен доступа, минуты · целое > 0 · везде
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Сколько живёт токен продления, сутки · целое > 0 · везде
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Алгоритм подписи · HS256 | HS384 | HS512 · везде
JWT_ALGORITHM=HS256

# --- Роли ---

# Роль, выдаваемая при регистрации · имя существующей роли · везде.
# Роль должна быть засеяна: `flask db load-base-roles`
DEFAULT_ROLE_NAME=user

# --- Ограничение частоты запросов ---
# Лимиты отдельных эндпоинтов заданы в коде (BaseConfig.RATE_LIMITS) и
# перечислены в docs/OPERATIONS_AND_MIGRATIONS.md.

# Предел для всех остальных маршрутов, запросов за окно · целое > 0 · везде
DEFAULT_RATE_LIMIT=100

# Длина окна, секунды · целое > 0 · везде
DEFAULT_RATE_LIMIT_PERIOD=60

# Снять лимиты со входа и регистрации · true | false · dev.
# Нужно, чтобы разработка не блокировала сама себя перебором паролей.
# На stag/prod это снимает защиту от подбора — оставляйте false
RATE_LIMIT_AUTH_DISABLED=false

# --- Браузерный доступ ---

# Origin'ы, которым разрешены запросы с учётными данными · список через
# запятую · везде. Звёздочка недопустима вместе с cookie
#
# Оба написания петлевого адреса, и это не перестраховка. Браузер шлёт тот
# Origin, который набрали в строке адреса, а CSRF-слой сверяет его с этим
# списком, прежде чем пропустить небезопасный запрос от cookie-сессии.
# С одним `localhost` открывший `http://127.0.0.1:5000` увидит рабочую
# главную (аноним CSRF не проходит) и «CSRF token missing or invalid» на
# любой форме сразу после входа — замерено живым прогоном.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Прокси, которым можно верить в X-Forwarded-For · список IP через запятую ·
# везде. Пусто — заголовок не читается вовсе, и адресом клиента считается
# тот, кто подключился. Указывайте здесь только собственный балансировщик:
# иначе клиент назовёт любой адрес и обойдёт гостевую квоту
TRUSTED_PROXIES=

# Слать cookie аутентификации только по HTTPS · true | false · везде.
# Профиль сам знает: false на dev, true на stag/prod
# COOKIE_SECURE=false

# То же для сессионной cookie самого Flask · true | false · везде.
# Профиль сам знает: false на dev, true на stag/prod
# SESSION_COOKIE_SECURE=false

# Когда браузер прикладывает сессионную cookie к межсайтовым запросам ·
# Strict | Lax | None · везде
SESSION_COOKIE_SAMESITE=Lax

# Скрыть сессионную cookie от JavaScript · true | false · везде.
# Оставляйте true
SESSION_COOKIE_HTTPONLY=true


# ==============================================================================
# 11. Только для docker compose
# ==============================================================================
# Эти переменные читает сам compose; приложение их не видит.

# Файл окружения, который compose передаёт контейнерам · путь · compose.
# Значение обязано совпадать с тем, что указано в --env-file
ENV_FILE=.env

# Какие инфраструктурные сервисы поднимать своими · список через запятую из
# db, cache, broker, mail · compose.
#
#   db      PostgreSQL       иначе задайте DATABASE_URL
#   cache   Redis для кэша   иначе задайте REDIS_URL
#   broker  Redis для Celery иначе задайте CELERY_BROKER_URL
#   mail    ловушка Mailpit  иначе задайте MAIL_HOST и MAIL_PORT
#   logs    ротация журналов иначе ротируйте их сами: без этого файлы
#                            растут до конца диска
#
# Пусто — поднимутся только migrations, app и celery_worker. Профиль mail
# объявлен в dockers/docker-compose.override.yml и в продакшн-форме стека
# не действует
COMPOSE_PROFILES=db,cache,broker,mail,logs

# Какие файлы compose составляют стек · пути через двоеточие · compose.
# Файлы лежат в dockers/, и без этой переменной каждая команда
# требовала бы двух флагов -f. Продакшн-форма — без второго файла:
#   docker compose -f dockers/docker-compose.yml --env-file .env.docker up -d
COMPOSE_FILE=dockers/docker-compose.yml:dockers/docker-compose.override.yml

# Каталог с исходниками, монтируемый в контейнер для горячей перезагрузки ·
# путь · compose.
# Относительный путь compose отсчитывает от каталога своего файла, то есть
# от dockers/ — отсюда `../`
APP_SRC_PATH=../src

# Каталог на хосте, куда складываются файлы журнала · путь · compose
LOG_HOST_PATH=../datas/logs

# Как часто ротатор проверяет журналы, секунды · целое > 0 · compose.
# Не частота ротации: файл подменяется раз в сутки, журнал аудита — раз в
# неделю. Опрос нужен затем, чтобы срабатывал ещё и потолок в 100 МБ,
# который проверяется только в момент вызова. Действует при включённом
# профиле logs
LOG_ROTATE_INTERVAL=3600

# Потолок на журнал контейнера у драйвера docker · размер и число файлов ·
# compose.
# Второй поток, помимо файлов журнала: туда идёт собственный журнал
# gunicorn (--access-logfile -) и всё, что пишет celery. У драйвера
# json-file нет границы по умолчанию, и без этих двух значений он копится
# в /var/lib/docker до конца диска
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Где хранить данные PostgreSQL · путь на хосте или имя тома · compose.
# Пусто — данные в именованном томе postgres_data, которым управляет docker.
# Значение с '/' или './' монтирует каталог: так базу можно положить на
# отдельный диск и забирать бэкапом с хоста
# DATABASE_DATA_PATH=/srv/link-shortener/postgres

# Где хранить данные Redis-кэша · путь на хосте или имя тома · compose
# REDIS_DATA_PATH=/srv/link-shortener/redis

# Где хранить данные Redis-брокера · путь на хосте или имя тома · compose.
# Очередь переживает перезапуск: задачи, поставленные до него, не теряются
# REDIS_BROKER_DATA_PATH=/srv/link-shortener/redis-broker

# Число рабочих процессов gunicorn · целое > 0 · compose.
# Ориентир — число ядер, и не больше. Таблица замера — DEVELOPER_GUIDE,
# «Нагрузочный профиль»
GUNICORN_WORKERS=4

# Класс рабочего процесса · sync | gthread | gevent · compose.
# Меняйте с осторожностью: GUNICORN_TIMEOUT прерывает зависший запрос
# только на sync
GUNICORN_WORKER_CLASS=sync

# Предел на один запрос, секунды · целое > 0 · compose.
# Последняя линия против зависшей зависимости: замороженный сервер БД не
# выполняет свой statement_timeout, и нижние тайм-ауты не срабатывают
GUNICORN_TIMEOUT=30

# Сколько секунд дают доиграть запрос при перезапуске · целое > 0 · compose.
# Обязано быть строго меньше GUNICORN_TIMEOUT
GUNICORN_GRACEFUL_TIMEOUT=20
