# ==============================================================================
# Link Shortener – шаблон конфигурации
# ==============================================================================
# Скопируйте файл и заполните секреты:
#
#   cp .env.example .env
#   flask security generate-secrets     # выдаст SECRET_KEY и SHORT_CODE_PEPPER
#
# ------------------------------------------------------------------------------
# Как значения попадают в приложение
# ------------------------------------------------------------------------------
# FLASK_ENV выбирает ПРОФИЛЬ (класс конфигурации) – development / staging /
# production / testing. Профиль задаёт умолчания, а .env их переопределяет.
#
# Приоритет (побеждает верхний):
#
#   1. Настоящая переменная окружения (export VAR=..., environment: в compose)
#   2. .env.<профиль>            например .env.production
#   3. .env                      этот файл
#   4. Умолчание профиля         код в infrastructure/configs/app/
#
# Профиль testing НЕ читает .env вообще – автотесты обязаны быть
# воспроизводимыми и берут значения только из TestingConfig.
#
# Все переменные ниже необязательны, кроме отмеченных как ОБЯЗАТЕЛЬНО.
# Закомментированная строка = используется умолчание профиля.
# ==============================================================================


# ==============================================================================
# 1. Профиль приложения
# ==============================================================================

# Профиль конфигурации: development | staging | production | testing
FLASK_ENV=development

# Точка входа для Flask CLI. Нужна для команд flask db / flask alembic / flask link
FLASK_APP=link_shortener.web.app_factory:create_app

# Режим отладки Flask. НИКОГДА не включайте в production –
# при исключении отдаётся интерактивная консоль Werkzeug.
FLASK_DEBUG=1

# PYTHONPATH здесь НЕ нужен: `uv sync` ставит проект в editable-режиме,
# поэтому пакет link_shortener импортируется сам. В docker-compose переменная
# задаётся отдельно (PYTHONPATH=/app/src), потому что в образ копируются
# только исходники, без установки пакета.


# ==============================================================================
# 2. Секреты                                                        ОБЯЗАТЕЛЬНО
# ==============================================================================
# В development при отсутствии генерируются случайно ПРИ КАЖДОМ ЗАПУСКЕ,
# из-за чего все выданные JWT становятся недействительными после рестарта.
# В staging и production отсутствие значения останавливает старт приложения.

# Подпись JWT и сессий Flask. Сгенерировать: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Секретная соль, подмешиваемая к URL перед хешированием.
# Делает короткие коды непредсказуемыми.
# ВАЖНО: должна быть ОДИНАКОВОЙ на всех инстансах, иначе один и тот же URL
# получит разные коды на разных серверах.
SHORT_CODE_PEPPER=


# ==============================================================================
# 3. Адрес сервиса
# ==============================================================================

# Интерфейс, на котором слушает сервер. 0.0.0.0 – все интерфейсы (нужно в Docker)
HOST=127.0.0.1

# Порт, который слушает само приложение (внутри контейнера — тоже он).
PORT=5000

# Порт приложения НА ХОСТЕ. Отделён от PORT: сдвинуть публикацию, когда
# 5000 занят, можно не трогая того, что слушает сам сервис. По умолчанию
# совпадает с PORT.
APP_HOST_PORT=5000

# Публичный домен сервиса, например short.example.com
# Если задан – короткие ссылки строятся как <схема>://<DOMAIN>/<код>,
# иначе как http://<HOST>:<PORT>/<код>
# ВАЖНО: при HOST=0.0.0.0 (Docker) задавать обязательно, иначе ссылки
# получатся вида http://0.0.0.0:5000/<код> и не откроются в браузере.
# В профиле production переменная обязательна – без неё старт прерывается.
# DOMAIN=

# Использовать https в публичных ссылках. В production ОБЯЗАТЕЛЬНО true
USE_HTTPS=false


# ==============================================================================
# 4. База данных
# ==============================================================================

# Тип СУБД: sqlite | postgresql
DATABASE_TYPE=sqlite

# Для sqlite DATABASE_NAME – это путь к файлу БД.
# Для postgresql – имя базы данных.
DATABASE_NAME=db_shortener.db

# --- Параметры подключения (только для postgresql) ---
DATABASE_HOST=localhost
# Порт, по которому приложение ходит в БД. В docker-сети это всегда 5432
# (порт образа), и compose подставляет его сам.
DATABASE_PORT=5432

# Порт PostgreSQL НА ХОСТЕ (внутри docker-сети он всегда 5432).
DATABASE_HOST_PORT=5432

# Адрес, на котором порт БД публикуется на хосте. По умолчанию петля:
# порт виден только с этой машины. Поставьте 0.0.0.0, только если в базу
# ходят с другой машины — тогда её видит вся сеть, и защищает её один
# лишь пароль.
DATABASE_BIND_ADDRESS=127.0.0.1
DATABASE_USER=
DATABASE_PASSWORD=

# Готовый URL целиком. Если задан – перекрывает все DATABASE_* выше.
# Пример: postgresql+psycopg://user:pass@localhost:5432/db_shortener
# Профили production и staging работают ТОЛЬКО на PostgreSQL и отвергают
# любую SQLite — названную в DATABASE_NAME, названную здесь или живущую в
# памяти. Умолчания кода — sqlite и db_shortener, — поэтому забытые
# настройки поднимали сервис на пустом новом файле в корне проекта, и он
# отвечал так, будто данных никогда не было. В development доступны оба
# бэкенда: SQLite для работы без сервера, PostgreSQL — чтобы проверяться
# на том же, на чём работает развёртывание.
# DATABASE_URL=

# Предел ожидания подключения к PostgreSQL, секунды. Без него ждём TCP-таймаут
# операционной системы — это минуты, а healthcheck контейнера сдаётся за 10 с.
DATABASE_CONNECT_TIMEOUT=3

# Предел на ОДИН SQL-запрос, секунды (statement_timeout на стороне сервера).
# Ограничивает медленные и залоченные запросы. Замороженный, но отвечающий на
# уровне ядра сервер этим НЕ закрывается — см. AUDIT_PLAN.
DATABASE_STATEMENT_TIMEOUT=10

# --- Пул соединений (учитывается только для postgresql) ---
# Постоянных соединений в пуле
DATABASE_POOL_SIZE=20
# Дополнительных соединений сверх пула при пиковой нагрузке
DATABASE_MAX_OVERFLOW=10
# Пересоздавать соединение через N секунд (защита от разрыва по таймауту)
DATABASE_POOL_RECYCLE=3600
# Проверять соединение перед выдачей из пула (защита от «протухших» коннектов)
DATABASE_POOL_PRE_PING=true

# Логировать каждый SQL-запрос. Только для отладки – шумно и раскрывает данные.
SQLALCHEMY_ECHO=false

# Схемой управляет Alembic. При false доступны flask db init / flask db drop,
# которые создают таблицы напрямую из моделей, минуя миграции.
USE_ALEMBIC=true

# База, с которой работает alembic, в обход конфигурации приложения. Здесь
# переменной не место — это канал передачи для одной команды, а не настройка
# развёртывания; задавайте её в самой команде:
#   ALEMBIC_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db \
#     alembic upgrade head
# Без неё alembic выбирает профиль как обычно и проверяет из него только то,
# что описывает подключение. Вне профиля development он откажется мигрировать
# SQLite, который не назван в DATABASE_URL: тип базы по умолчанию — sqlite,
# поэтому забытые настройки давали успешную миграцию пустого нового файла.
# По той же причине профиль обязан быть назван — в FLASK_ENV или здесь:
# умолчание тоже development, и неназванный профиль отключал бы проверку.
# Подробности — docs/OPERATIONS_AND_MIGRATIONS.md, «Миграция без приложения».

# Досоздавать системные роли и разрешения при старте приложения.
# Операция идемпотентна. В production выключено: все изменения – через миграции
# и явную команду flask db load-base-roles.
AUTO_SEED_ROLES=true


# ==============================================================================
# 5. Кэш и Redis
# ==============================================================================

# Общий выключатель кэширования. При false используется NullCache (все операции – no-op)
CACHE_ENABLED=true

# Использовать Redis. При false – кэш в памяти процесса (только для разработки:
# не переживает рестарт и не разделяется между воркерами).
REDIS_ENABLED=false

# Строка подключения: redis://[:пароль@]хост:порт/номер_базы
REDIS_URL=redis://localhost:6379/0

# Пароль Redis. Используется docker-compose для сборки REDIS_URL и запуска сервера.
REDIS_PASSWORD=

# Порт, по которому приложение ходит в Redis. В docker-сети это всегда
# 6379 (порт образа), и compose подставляет его сам.
REDIS_PORT=6379

# Порт Redis НА ХОСТЕ (внутри docker-сети он всегда 6379).
REDIS_HOST_PORT=6379

# Таймаут установки соединения, секунды
REDIS_CONNECT_TIMEOUT=2
# Таймаут чтения/записи, секунды
REDIS_SOCKET_TIMEOUT=2
# Пауза между попытками переподключения после падения Redis, секунды
REDIS_RETRY_INTERVAL=10

# Префикс всех ключей – позволяет держать в одном Redis несколько приложений
CACHE_LINK_PREFIX=link_shortener

# Время жизни закэшированного объекта ссылки, секунды
CACHE_LINK_TTL=3600
# Время жизни закэшированной статистики сервиса, секунды
CACHE_STATS_TTL=300


# ==============================================================================
# 6. Celery (фоновые задачи)
# ==============================================================================
# Используется для асинхронного подсчёта кликов.
# При false клики считаются синхронно прямо в обработчике редиректа –
# это работает, но добавляет запрос к БД в критический путь.

CELERY_ENABLED=false

# Брокер и бэкенд результатов.
# В docker-стеке это ОТДЕЛЬНЫЙ инстанс Redis (сервис redis_broker), а не тот,
# что обслуживает кэш. Причина: кэш работает с maxmemory-policy=allkeys-lru,
# а эта политика действует на сервер целиком, а не на отдельную базу — очередь
# задач вытеснялась вместе с кэшем и исчезала молча. У брокера noeviction.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Порт брокера НА ХОСТЕ (внутри docker-сети он всегда 6379).
# 6380 занят тестовым стеком docker-compose.test.yml — не переиспользовать.
REDIS_BROKER_HOST_PORT=6381

# Предел ожидания брокера в секундах. Задача ставится в очередь прямо в
# обработчике запроса, поэтому любое ожидание брокера видит клиент.
CELERY_BROKER_TIMEOUT=2


# ==============================================================================
# 6.1. Проверка состояния (/health)
# ==============================================================================
# Общий бюджет времени на опрос всех зависимостей, секунды. Компонент, не
# уложившийся в бюджет, отдаётся как timeout. Держите значение ниже, чем
# timeout healthcheck'а в docker-compose.yml (там 10 с): ответ, пришедший
# позже, для оркестратора неотличим от отсутствия ответа.
HEALTH_CHECK_TIMEOUT=5


# ==============================================================================
# 6.2. Почта и подтверждение адреса
# ==============================================================================
# Канал, которым сервис отправляет письмо со ссылкой подтверждения. Пока он
# выключен, регистрация работает как раньше, но подтвердить адрес нечем: учётка
# создаётся неподтверждённой, а вход неподтверждённую отвергает. То есть с
# MAIL_ENABLED=false зарегистрироваться можно, а войти — нет, пока адрес не
# подтвердят иначе (например, администратором через админский API).
MAIL_ENABLED=false

# Адрес сервера отправки. Без значения при MAIL_ENABLED=true запуск падает
# с внятной ошибкой — по умолчанию здесь пусто намеренно: значение вроде
# localhost выглядело бы настроенным и молча упиралось бы в таймаут.
MAIL_HOST=

# Порт отправки. 587 — это STARTTLS (в паре с MAIL_USE_TLS), 465 — TLS с
# первого байта (в паре с MAIL_USE_SSL). RFC 8314 считает их равноценными
# при условии, что TLS обязателен с обеих сторон, так что это выбор
# развёртывания, а не выбор безопасности.
MAIL_PORT=587

# Учётные данные. Имя без пароля и пароль без имени одинаково отвергаются
# при запуске: первое отказывает на каждом письме, второе не используется.
# С заданным именем канал ОБЯЗАН быть зашифрован — иначе пароль уходит по
# сети открытым текстом, и отправитель откажется его посылать.
MAIL_USERNAME=
MAIL_PASSWORD=

# Шифрование. Взаимоисключающие: STARTTLS внутри уже зашифрованного
# соединения — это протокольная ошибка, а не двойная защита.
# В профилях production и staging отправка без шифрования запрещена совсем.
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Адрес, от чьего имени уходит письмо. Принимающие домены сверяют его с SPF
# и DMARC: несоответствие означает не отказ, а недоставку в тишине.
MAIL_FROM=

# Предел на одну блокирующую операцию с сервером, секунды. Не отключается:
# без него smtplib берёт глобальный таймаут сокета, а он None — сервер,
# принявший соединение и замолчавший, держит поток сколько захочет.
# Внимание: это предел на ОДНУ операцию, а не на всю отправку. Медленный
# сервер (по 0.8 с на команду) укладывался в 5.7 с при MAIL_TIMEOUT=1.
MAIL_TIMEOUT=10

# Сколько часов живёт ссылка подтверждения.
EMAIL_VERIFICATION_TTL_HOURS=24

# Через сколько часов неподтверждённая учётка удаляется. Не меньше, чем
# EMAIL_VERIFICATION_TTL_HOURS: иначе учётку снесёт, пока её собственная
# ссылка ещё жива, и человек по живой ссылке получит «недействительна».
# Без этой уборки неподтверждённая регистрация держит адрес навсегда:
# зарегистрировать его заново нельзя, войти в него нельзя.
UNVERIFIED_ACCOUNT_TTL_HOURS=72

# Порты локального ловца писем (Mailpit) на ХОСТЕ. Поднимается только
# разработческой надстройкой docker-compose.override.yml, обе привязки
# петлевые. SMTP слушает 1025, веб-интерфейс — 8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# ==============================================================================
# 7. Логирование и аудит
# ==============================================================================

# Общий выключатель логирования приложения
LOGGING_ENABLED=true

# Аудит значимых событий (создание, доступ, удаление ссылок).
# В production держите включённым.
AUDIT_ENABLED=true

# Реализация логгера: auto | structlog | standard | null
# auto – пробует structlog, при неудаче деградирует до standard, затем до null
# Регистр и пробелы не важны: NULL, Null и " null " означают то же, что null.
# Раньше значение сравнивалось посимвольно, поэтому AUDIT_TYPE=NULL молча
# давал ПОЛНЫЙ аудит там, где его выключали. Нераспознанное значение
# по-прежнему приводит к цепочке auto.
LOGGER_TYPE=auto
AUDIT_TYPE=auto

# Уровень: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Куда писать. Для контейнеров предпочтителен console (логи собирает Docker).
LOG_TO_CONSOLE=true
LOG_TO_FILE=false

# Каталог и имена файлов логов (без расширения).
# Относительный путь отсчитывается от корня проекта, а не от каталога, из
# которого запущен процесс, — иначе воркер, запущенный не оттуда, пишет
# логи туда, где их никто не ищет. Абсолютный путь берётся как есть.
LOG_DIR=logs
LOG_FILENAME=application
AUDIT_LOG_FILENAME=audit
ERROR_LOG_FILENAME=error

# Уровни для сторонних библиотек – в production держите на WARNING
SQLALCHEMY_LOG_LEVEL=WARNING
WERKZEUG_LOG_LEVEL=WARNING

# Как часто failover-механизм пытается вернуться к основному логгеру, секунды
FAILOVER_CHECK_INTERVAL=30


# ==============================================================================
# 8. Правила работы со ссылками
# ==============================================================================

# Разрешённые схемы URL, через запятую
ALLOWED_SCHEMES=http,https

# Максимальная длина исходного URL. Выше 2048 поднять нельзя: это ширина
# колонки urls.original_url, и более длинный URL упал бы уже на вставке.
MAX_URL_LENGTH=2048

# Разрешить сокращать ссылки внутрь собственной сети развёртывания:
# петля, приватные диапазоны, link-local (169.254.169.254 — метаданные
# облака), служебные имена вида *.internal и *.svc.
# false (по умолчанию) — публичный сокращатель. Принимая такие адреса, он
# шлёт запросы из браузера посетителя внутрь сети посетителя под своим
# доменом.
# true — только для развёртывания, весь смысл которого в сокращении
# интранет-ссылок и которое снаружи этого интранета недоступно.
ALLOW_INTERNAL_TARGETS=false

# Сколько попыток сгенерировать код при коллизии
MAX_COLLISION_ATTEMPTS=5

# Максимум URL в одном пакетном запросе
BATCH_CREATE_LIMIT=100

# --- Гостевые ссылки (без регистрации) ---
# Максимум ссылок с одного IP за окно
GUEST_LINK_LIMIT=10
# Размер окна подсчёта, дни
GUEST_LINK_WINDOW_DAYS=1
# Время жизни гостевой ссылки, секунды (604800 = 7 суток).
# Это и значение по умолчанию, и потолок: гость, попросивший больше,
# получит именно столько. Ноль запрещён — он означал бы «никогда не
# истекает».
DEFAULT_GUEST_TTL_SECONDS=604800

# Максимальный срок жизни ссылки для кого угодно, секунды
# (315360000 = 10 лет). Больше — ответ 400.
MAX_TTL_SECONDS=315360000

# Минимальная длина пароля и проверка по списку самых частых паролей
# заданы в коде (domain/policies/password_policy.py, NIST SP 800-63B):
# 8 символов, без требований «цифра и спецсимвол» — они рождают Password1!,
# который в начале любого словаря. Настройкой не выносится намеренно.

# --- Пороги для расширенной аналитики ---
# Начиная со скольких кликов ссылка считается популярной
POPULAR_THRESHOLD=100
# Сколько дней ссылка считается свежей
RECENT_DAYS=7


# ==============================================================================
# 9. JWT-аутентификация
# ==============================================================================

# Время жизни access-токена, минуты (держите коротким)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Время жизни refresh-токена, дни
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Алгоритм подписи
JWT_ALGORITHM=HS256


# ==============================================================================
# 10. Роли по умолчанию
# ==============================================================================

# Роль, выдаваемая при регистрации. Должна существовать в БД
# (создаётся командой flask db load-base-roles).
DEFAULT_ROLE_NAME=user

# Разрешения роли по умолчанию – используются, только если роль
# приходится создавать программно.
DEFAULT_ROLE_PERMISSIONS=link:create,link:view_own,link:delete_own,stats:view_basic


# ==============================================================================
# 11. Ограничение частоты запросов
# ==============================================================================
# Лимиты для конкретных эндпоинтов заданы в коде (BaseConfig.RATE_LIMITS).
# Значения ниже применяются к эндпоинтам без индивидуальной настройки.

# Запросов за окно
DEFAULT_RATE_LIMIT=100
# Длина окна, секунды
DEFAULT_RATE_LIMIT_PERIOD=60

# Отключить лимиты на /api/v1/auth/* – снимает защиту от подбора паролей.
# Только для локальной отладки и тестов.
RATE_LIMIT_AUTH_DISABLED=false


# ==============================================================================
# 12. Безопасность веб-слоя
# ==============================================================================

# Разрешённые источники для CORS, через запятую.
# Не используйте *, если включены cookie-запросы.
CORS_ORIGINS=http://localhost:5000

# IP-адреса доверенных прокси через запятую.
# Заголовку X-Forwarded-For доверяют, ТОЛЬКО если запрос пришёл с одного из них,
# и берут из него КРАЙНИЙ ПРАВЫЙ элемент — единственный, который клиент
# подделать не может, потому что его дописал сам прокси.
# Пустое значение = заголовок игнорируется, берётся адрес соединения.
# Заполните, если сервис стоит за nginx или балансировщиком, иначе rate limit
# и учёт гостевых ссылок будут считать всех клиентов одним IP.
# Прокси ОБЯЗАН дописывать адрес справа: у nginx это
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# Если прокси пробрасывает заголовок клиента как есть, личность гостя
# назначает клиент, и гостевая квота перестаёт что-либо считать.
# ВАЖНО для развёртывания за обратным прокси. Пока список пуст, заголовок
# X-Forwarded-For игнорируется (и правильно — его может дописать кто угодно),
# но тогда приложение видит всех клиентов как ОДИН адрес: адрес прокси или
# шлюза docker-сети. Следствие: лимиты и гостевая квота становятся общими на
# весь сервис. Шесть неудачных входов от одного клиента — и вход с верным
# паролем получает 429 у всех остальных.
# Укажите здесь адрес самого прокси, чтобы читался крайний правый элемент.
TRUSTED_PROXIES=

# Флаг Secure для cookie аутентификации. В production ОБЯЗАТЕЛЬНО true
# (иначе cookie уйдёт по открытому HTTP).
COOKIE_SECURE=false

# --- Сессионная cookie самого Flask ---
# Отдавать только по HTTPS. В production по умолчанию true.
SESSION_COOKIE_SECURE=false
# Политика SameSite: Strict | Lax | None
SESSION_COOKIE_SAMESITE=Lax
# Запретить доступ к cookie из JavaScript. Менять не следует.
SESSION_COOKIE_HTTPONLY=true


# ==============================================================================
# 13. Только для docker-compose
# ==============================================================================
# Эти переменные читает сам docker compose, приложение их не использует.

# Файл окружения, который compose монтирует в контейнеры.
# Оставьте .env, если запускаете compose без --env-file.
ENV_FILE=.env

# Каталог с исходниками, монтируемый в контейнер (hot reload)
APP_SRC_PATH=./src

# Каталог на хосте для логов контейнера
LOG_HOST_PATH=./logs

# Число воркеров gunicorn в production-образе.
# Рекомендация: 2 × количество ядер + 1
GUNICORN_WORKERS=2

# Класс воркера. Менять с осторожностью: GUNICORN_TIMEOUT гарантированно
# прерывает зависший запрос только на sync — у gthread один запрос может
# идти бесконечно, и потолок перестанет действовать.
GUNICORN_WORKER_CLASS=sync

# Потолок на один запрос, секунды. Воркер, молчащий дольше, убивается и
# перезапускается. Это последняя линия против зависшей (а не упавшей)
# зависимости: замороженный сервер БД не выполняет свой statement_timeout,
# и его ядро подтверждает keepalive, поэтому ни один из нижних таймаутов
# не срабатывает.
GUNICORN_TIMEOUT=30

# Сколько секунд воркеру дают доиграть запрос при перезапуске.
# Обязано быть строго меньше GUNICORN_TIMEOUT.
GUNICORN_GRACEFUL_TIMEOUT=20
