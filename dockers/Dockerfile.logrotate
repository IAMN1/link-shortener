# syntax=docker/dockerfile:1

# Тот же bookworm, на котором собран образ приложения: одна система
# пакетов и один набор системных утилит на стек вместо двух.
FROM debian:bookworm-slim

# gettext-base ради одного envsubst: имена журналов подставляются в шаблон
# при старте, чтобы ротатор следил за теми же файлами, что пишет
# приложение. Подстановка руками, через sed, обошлась бы без пакета и
# читалась бы хуже — envsubst называет ровно те переменные, которые ему
# разрешено трогать.
RUN apt-get update && apt-get install -y --no-install-recommends \
    logrotate \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Путь от корня проекта: контекст сборки — корень, как и у образа
# приложения. Кладётся шаблоном: готовый конфиг из него делает entrypoint,
# подставляя имена журналов.
COPY dockers/logrotate.conf /etc/logrotate.d/link_shortener.template
COPY dockers/logrotate-entrypoint.sh /logrotate-entrypoint.sh
RUN chmod +x /logrotate-entrypoint.sh

# Расписание циклом, а не cron.
#
# Демону расписаний в контейнере пришлось бы отдать свой вывод (cron пишет
# его почтой, которой здесь нет), синхронизировать время и остановиться
# по сигналу от docker. Цикл — один процесс: его видно в `docker ps`, его
# вывод идёт в `docker logs`, и он заканчивается вместе с контейнером.
#
# Час — это частота опроса, а не частота ротации. Как часто файл
# подменяется, решают daily и weekly в конфиге; ежечасный вызов нужен
# затем, чтобы сработал ещё и maxsize, который проверяется только в
# момент вызова.
#
# Файл состояния лежит рядом с журналами, на смонтированном томе: в самом
# контейнере он не пережил бы перезапуск, и первый же вызов после него
# ротировал бы файлы заново, не дождавшись суток.
#
# Сам цикл и подстановка имён — в /logrotate-entrypoint.sh.
ENV LOG_ROTATE_INTERVAL=3600

CMD ["/logrotate-entrypoint.sh"]
