# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.env
.env.*
# The configuration templates: the only env files that belong in git. Both
# negations are needed and neither is redundant -- `.env.*` matches
# `.env.docker.example` as readily as it matches a real `.env.docker`, so
# without the second line the Docker template would be ignored and the
# Docker path would ship with no template at all.
!.env.example
!.env.docker.example

# Everything a run leaves behind lives in datas/: databases and journals.
# The directories create themselves, and travel in git empty -- so the place
# for them is visible in the tree rather than only in the documentation.
datas/databases/*
!datas/databases/.gitkeep
datas/logs/*
!datas/logs/.gitkeep
*.db
:memory

# macOS writes one of these into every folder its Finder opens. They carry
# the window's own view settings and nothing about the project.
.DS_Store

# accidental files
# The DATABASE_NAME default carries no extension, so *.db does not cover it.
# Kept for a file created before the move into datas/databases/.
db_shortener

# Pytest-generated files
.pytest_cache/
.coverage
htmlcov/
test-results/
coverage.xml

# Mypy-generated files
.mypy_cache/
