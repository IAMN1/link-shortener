# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.env
.env.*
# Шаблон конфигурации — единственный env-файл, который должен быть в git
!.env.example

# Всё, что оставляет после себя запуск, живёт в datas/: базы и логи.
# Каталоги создаются сами, а в git едут пустыми — чтобы место было видно
# по дереву, а не только по документации.
datas/databases/*
!datas/databases/.gitkeep
datas/logs/*
!datas/logs/.gitkeep
*.db
:memory

# macOS writes one of these into every folder its Finder opens. They carry
# the window's own view settings and nothing about the project.
.DS_Store

# accidental files
# Умолчание DATABASE_NAME идёт без расширения, поэтому под *.db не попадает.
# Оставлено на случай файла, созданного до переезда в datas/databases/.
db_shortener

# Pytest-generated files
.pytest_cache/
.coverage
htmlcov/
test-results/
coverage.xml

# Mypy-generated files
.mypy_cache/
